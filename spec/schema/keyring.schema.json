{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pelco-release:v1:keyring",
  "title": "Pelco release verification keyring, format version 1",
  "description": "Public signing keys a verifier trusts, and what each may sign. Recipient (decryption) keys are never kept here.",
  "type": "object",
  "required": ["format", "format_version", "keys"],
  "properties": {
    "format": { "const": "pelco-release-keyring" },
    "format_version": { "const": 1 },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "alg", "public_key", "channels", "products"],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "alg": { "const": "ed25519" },
          "public_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "channels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["test", "release"] }
          },
          "products": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" }
          },
          "not_after": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          }
        }
      }
    }
  }
}
